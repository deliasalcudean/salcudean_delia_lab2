@page
@model salcudean_delia_lab2.Pages.CategoryPages.IndexModel

@{
    ViewData["Title"] = "Categories";
}

<h1>Categories</h1>

<table class="table">
    <thead>
        <tr>
            <th>Category Name</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Category)
        {
            <tr>
                <td>
                    <a asp-page="./Index"
                       asp-route-categoryId="@item.ID">
                        @item.CategoryName
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.SelectedCategoryName != null)
{
    <h2>Books in category: @Model.SelectedCategoryName</h2>

    @if (Model.Books.Any())
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Author</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var book in Model.Books)
                {
                    <tr>
                        <td>@book.Title</td>
                        <td>@book.Author?.FullName</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>There are no books in this category.</p>
    }
}
