@page
@model salcudean_delia_lab2.Pages.PublisherPages.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Publisher</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Publisher Name
        </dt>
        <dd class="col-sm-10">
            @Model.Publisher.PublisherName
        </dd>
    </dl>
    <h4>Books</h4>
    @if (Model.Publisher.Books != null && Model.Publisher.Books.Any())
    {
        <ul>
        @foreach (var b in Model.Publisher.Books)
        {
            <li>@b.Title</li>
        }
        </ul>
    }
    else
    {
        <p><em>No books.</em></p>
    }
</div>

<div>
    <a asp-page="./Edit" asp-route-id="@Model.Publisher.ID">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
